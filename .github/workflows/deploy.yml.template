# by Claude — Deploy web frontend and server Lambda on push to main/master
name: Deploy

on:
  push:
    branches: [ master, main ]

jobs:
  deploy-web:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Build production web bundle
        run: ./gradlew :apps:viteBuild

      - name: Deploy web to AWS
        run: ./gradlew :apps:deployWebdefault
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}

  deploy-server:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Build Lambda package
        run: ./gradlew :server:lambda

      - name: Upload Lambda artifact
        uses: actions/upload-artifact@v4
        with:
          name: server-lambda
          path: server/build/libs/*-lambda.jar
          retention-days: 30
