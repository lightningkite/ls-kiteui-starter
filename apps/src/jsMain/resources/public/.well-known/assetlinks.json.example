[{
  "relation": ["delegate_permission/common.handle_all_urls", "delegate_permission/common.get_login_creds"],
  "target": {
    "namespace": "android_app",
    "package_name": "com.lightningkite.lskiteuistarter.app",
    "sha256_cert_fingerprints": ["<key-hash>"] // This will allow for using passkeys in an android app
  }
}]